<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:layout_gravity="center_horizontal|top"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:padding="16dp">

        <TextView
            android:id="@+id/textView_varian"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Varian"
            android:textColor="@color/black"
            android:textAlignment="center"
            android:textSize="40sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/popup"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView_varian_goreng"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/mregular"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:text="Goreng"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/textView_harga_goreng"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/mregular"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:text="15 K"
                android:textAlignment="center" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/popup"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView_varian_rica"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/mregular"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:text="Rica-Rica"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/textView_harga_rica"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/mregular"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:text="18 K"
                android:textAlignment="center" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/popup"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView_varian_rica1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/mregular"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:text="Geprek"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/textView_harga_rica2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/mregular"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:text="18 K"
                android:textAlignment="center" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/popup"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView_varian_balado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/mregular"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:text="Balado"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/textView_harga_balado"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:text="16 K"
                android:fontFamily="@font/mregular"
                android:textAlignment="center" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/popup"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textView_varian_kecap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:text="Kecap"
                android:fontFamily="@font/mregular"
                android:textAlignment="center" />

            <TextView
                android:id="@+id/textView_harga_kecap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/mregular"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:text="17 K"
                android:textAlignment="center" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
