<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".List_Menu_Minuman">


    <!-- Menu items -->
    <LinearLayout
        android:id="@+id/menuListLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- TextView "TAMBAH MENU" -->
        <TextView
            android:id="@+id/textViewAddMenu"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="60dp"
            android:text="TAMBAH MENU"
            android:layout_marginBottom="100dp"
            android:textSize="25dp"
            android:fontFamily="@font/mextrabold"
            android:textColor="@color/blueprimry" />

        <!-- Menu item 1 -->
        <LinearLayout
            android:id="@+id/menuItem1Layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:orientation="horizontal"
            android:layout_marginBottom="15dp"
            android:background="@drawable/menu_item_background">

            <TextView
                android:id="@+id/menuItem1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="20dp"
                android:text="Kopi"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:padding="8dp"
                android:fontFamily="@font/mextrabold"
                android:clickable="true"
                android:onClick="editMenuItem" />

            <Button
                android:id="@+id/buttonEdit1"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:onClick="editMenuItem"
                android:background="@drawable/edit_btn"
                android:layout_marginStart="8dp"/>

            <Button
                android:id="@+id/buttonDelete1"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginEnd="20dp"
                android:onClick="deleteMenuItem"
                android:background="@drawable/icn_sampah"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Menu item 2 -->
        <LinearLayout
            android:id="@+id/menuItem2Layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:orientation="horizontal"
            android:layout_marginBottom="15dp"
            android:background="@drawable/menu_item_background">

            <TextView
                android:id="@+id/menuItem2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="20dp"
                android:text="Soda"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:fontFamily="@font/mextrabold"
                android:padding="8dp"
                android:clickable="true"
                android:onClick="editMenuItem" />

            <Button
                android:id="@+id/buttonEdit2"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:onClick="editMenuItem"
                android:background="@drawable/edit_btn"
                android:layout_marginStart="8dp"/>

            <Button
                android:id="@+id/buttonDelete2"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:onClick="deleteMenuItem"
                android:layout_marginEnd="20dp"
                android:background="@drawable/icn_sampah"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <!-- Menu item 3 -->
        <LinearLayout
            android:id="@+id/menuItem3Layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:orientation="horizontal"
            android:layout_marginBottom="15dp"
            android:background="@drawable/menu_item_background">

            <TextView
                android:id="@+id/menuItem3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="20dp"
                android:text="Teh"
                android:textColor="@color/black"
                android:textSize="22sp"
                android:padding="8dp"
                android:fontFamily="@font/mextrabold"
                android:clickable="true"
                android:onClick="editMenuItem" />

            <Button
                android:id="@+id/buttonEdit3"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:onClick="editMenuItem"
                android:background="@drawable/edit_btn"
                android:layout_marginStart="8dp"/>

            <Button
                android:id="@+id/buttonDelete3"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:onClick="deleteMenuItem"
                android:layout_marginEnd="20dp"
                android:background="@drawable/icn_sampah"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Guideline for spacing -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.5"/>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/floatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="68dp"
        android:background="@drawable/bg_gray_lagi"
        android:src="@drawable/addcircle1"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="MissingConstraints"
        tools:layout_editor_absoluteY="703dp" />

    <!-- Floating Action Button -->

</androidx.constraintlayout.widget.ConstraintLayout>